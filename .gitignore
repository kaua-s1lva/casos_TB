# =============================================================================
# .gitignore — TCC: abandono do tratamento da tuberculose
# =============================================================================

# -----------------------------------------------------------------------------
# Credenciais e configurações locais (NUNCA versionar)
# -----------------------------------------------------------------------------
.env
.env.*
# modelo do .env sem senhas, este pode ir para o Git
!.env.example
*.pem
*.key
secrets.*
credenciais.*

# -----------------------------------------------------------------------------
# Dados — microdados do SINAN são dados de saúde; não sobem para o Git.
# As pastas continuam no repositório pelos arquivos .gitkeep.
# -----------------------------------------------------------------------------
data/raw/*
data/interim/*
data/processed/*
data/external/*
!data/**/.gitkeep

# planilhas, bases e dumps em qualquer lugar do projeto
*.xlsx
*.xls
*.xlsm
*.ods
*.csv
*.parquet
*.feather
*.pkl
*.pickle
*.sav
*.dbf
*.dbc
*.sql.gz
*.dump
*.sqlite
*.sqlite3
*.db
# arquivos temporários do Excel/Word abertos
~$*

# exceções: arquivos pequenos de resultado que fazem parte do trabalho
!reports/*.csv

# -----------------------------------------------------------------------------
# Modelos treinados e artefatos de treino (regeráveis pelos scripts)
# -----------------------------------------------------------------------------
models/*
!models/.gitkeep
*.joblib
*.onnx
*.h5
*.keras
*.ckpt
*.pt
checkpoints/
lightning_logs/
# TensorBoard
runs/
# MLflow
mlruns/
# Weights & Biases
wandb/
catboost_info/
optuna*.db

# -----------------------------------------------------------------------------
# Python
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# ambientes virtuais
.venv/
venv/
env/
ENV/
.conda/

# testes, tipagem e linters
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/
.pyre/

# -----------------------------------------------------------------------------
# Jupyter
# -----------------------------------------------------------------------------
.ipynb_checkpoints/
*/.ipynb_checkpoints/*
profile_default/
ipython_config.py

# -----------------------------------------------------------------------------
# Logs e arquivos temporários
# -----------------------------------------------------------------------------
*.log
logs/
tmp/
temp/
*.tmp
*.bak
*.swp

# -----------------------------------------------------------------------------
# Editores e sistema operacional
# -----------------------------------------------------------------------------
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.code-workspace
Thumbs.db
desktop.ini
.DS_Store

# -----------------------------------------------------------------------------
# Documentos pesados ou gerados fora do código
# -----------------------------------------------------------------------------
# Power BI (contém os dados embutidos)
*.pbix
*.pdf
